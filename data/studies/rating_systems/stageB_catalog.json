      "glicko_cs|single"
    ],
    "tuned": {
      "atp": {
        "constants": {
          "rd0": 600.0,
          "sigma0": 0.07,
          "rho": 0.99,
          "w": 0.0
        },
        "tuned_on": "2013-2018 evaluation matches"
      },
      "wta": {
        "constants": {
          "rd0": 700.0,
          "sigma0": 0.08,
          "rho": 0.995,
          "w": 0.0
